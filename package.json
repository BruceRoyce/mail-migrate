{
  "name": "reliable-mail-migrate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "mail-migrate": "dist/cli.js"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "build": "tsc && vite build web --outDir ../web-dist",
    "check": "tsc --noEmit && tsc -p web/tsconfig.json",
    "test": "tsx --test test/*.test.ts",
    "integration": "tsx --test test/integration/*.test.ts",
    "start": "tsx src/cli.ts",
    "web": "tsx src/cli.ts web",
    "test:ui": "playwright test",
    "lint": "prettier --check .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@fastify/static": "^10.1.4",
    "commander": "^15.0.0",
    "fastify": "^5.12.5",
    "imapflow": "^2.0.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prettier": "^3.9.8",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
